# AgentBets X Bot Configuration
# ================================
# Copy this file to .env and fill in the values
# For Railway: Set these as service environment variables

# Bot Server
BOT_PORT=3003
NODE_ENV=development

# Data persistence directory (optional, defaults to ./data)
# DATA_DIR=/app/data

# ============================================
# REQUIRED - Bot will not work without these
# ============================================

# AgentBets API URL (required for creating markets and proposing resolutions)
AGENTBETS_API_URL=http://localhost:3002/api

# AgentBets API Key (REQUIRED - must match AGENTBETS_API_KEY in API server)
# This protects the API from spam and unauthorized access
# Generate the same key: openssl rand -hex 32
AGENTBETS_API_KEY=your-secret-api-key-here

# Twitter/X API Bearer Token (REQUIRED for follower verification)
# Get this from https://developer.twitter.com/en/portal/projects
# Without this, bets about follower counts CANNOT be verified!
TWITTER_BEARER_TOKEN=your-bearer-token

# ============================================
# REQUIRED FOR POSTING TWEETS
# ============================================

# Twitter OAuth 1.0a credentials (required for posting tweets)
TWITTER_API_KEY=your-api-key
TWITTER_API_SECRET=your-api-secret
TWITTER_ACCESS_TOKEN=your-access-token
TWITTER_ACCESS_SECRET=your-access-secret

# ============================================
# OPTIONAL
# ============================================

# AgentBets frontend URL (for generating market links)
AGENTBETS_URL=https://agentbets.gg

# ============================================
# INFERENCE.SH CLI (Alternative Twitter Backend)
# ============================================
# Use inference.sh CLI for posting tweets instead of twitter-api-v2
# Enables enhanced features: media posting, DMs, following
# Requires: curl -fsSL https://cli.inference.sh | sh && infsh login
USE_INFSH=false

# Moltbook API (for agent verification via Moltbook)
MOLTBOOK_API_URL=https://api.moltbook.com/v1
MOLTBOOK_API_KEY=your-moltbook-api-key

# GitHub API (for GitHub-based resolutions)
GITHUB_TOKEN=your-github-token

# CoinGecko API key (for token price resolution)
COINGECKO_API_KEY=your-coingecko-api-key

# Announce resolution proposals on Twitter (true/false)
ANNOUNCE_PROPOSALS=true
