# AgentBets X Bot Configuration

# Bot Server
BOT_PORT=3003
NODE_ENV=development

# AgentBets API
AGENTBETS_API_URL=http://localhost:3002/api
AGENTBETS_URL=https://agentbets.gg
AGENTBETS_API_KEY=your-api-key-here

# Twitter/X API Credentials
# For reading tweets (Bearer Token)
TWITTER_BEARER_TOKEN=your-bearer-token

# For posting tweets (OAuth 1.0a)
TWITTER_API_KEY=your-api-key
TWITTER_API_SECRET=your-api-secret
TWITTER_ACCESS_TOKEN=your-access-token
TWITTER_ACCESS_SECRET=your-access-secret

# Moltbook API (for agent verification)
MOLTBOOK_API_URL=https://api.moltbook.com/v1
MOLTBOOK_API_KEY=your-moltbook-api-key

# GitHub API (for repo-based resolutions)
GITHUB_TOKEN=your-github-token
