# AgentBets Frontend Configuration
# Copy this to .env and fill in the values

# API Base URL (defaults to /api for proxy)
VITE_API_URL=/api

# Solana network (mainnet-beta or devnet)
VITE_SOLANA_NETWORK=mainnet-beta

# Custom RPC URL (recommended - overrides clusterApiUrl)
VITE_SOLANA_RPC_URL=https://api.mainnet.solana.com

# Escrow wallet for receiving bets
VITE_ESCROW_WALLET=48sWTmPygvc4w2RqKMao6zXWPGzpnnD1uecXJbCkRnQM

# Admin wallet for resolution confirmation
VITE_ADMIN_WALLET=ESutJq7VqRER499A78W9BJCjdtZAqMJWy6hjf4HCjtsG

# USDC Token Mint (mainnet)
VITE_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
