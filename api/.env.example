# AgentBets API Server Configuration
# Copy this to .env and fill in the values

# ===========================================
# REQUIRED - Solana Configuration
# ===========================================

# Bot keypair for creating/resolving markets on Poll.fun
# Generate with: solana-keygen new --outfile keypair.json
# Then convert to base58: node -e "console.log(require('bs58').encode(require('./keypair.json')))"
SOLANA_PRIVATE_KEY=

# Escrow wallet for receiving bets (default provided, but use your own in production)
ESCROW_WALLET=48sWTmPygvc4w2RqKMao6zXWPGzpnnD1uecXJbCkRnQM

# Solana RPC endpoint (mainnet for production, devnet for testing)
SOLANA_RPC_URL=https://api.mainnet.solana.com

# Network selection: mainnet or devnet
# NOTE: Poll.fun program only exists on mainnet
SOLANA_NETWORK=mainnet

# Poll.fun network override (defaults to mainnet, the only network with the program)
# POLLFUN_NETWORK=mainnet
# POLLFUN_RPC_URL=https://api.mainnet.solana.com

# ===========================================
# OPTIONAL - Platform Configuration
# ===========================================

# API server port (default: 3002)
PORT=3002

# Public URL for Blink icon and links
AGENTBETS_URL=https://agentbets.gg

# Admin wallet for market resolution confirmation
# ADMIN_WALLET=ESutJq7VqRER499A78W9BJCjdtZAqMJWy6hjf4HCjtsG

# SOL price in USD for USDC conversion (default: 150)
# SOL_PRICE_USD=150

# ===========================================
# SECURITY SETTINGS
# ===========================================

# API Key for bot/agent authentication (REQUIRED for protected endpoints)
# Generate a secure random key: openssl rand -hex 32
AGENTBETS_API_KEY=your-secret-api-key-here

# CORS allowed origins (comma-separated). Use '*' for dev, restrict in production
# CORS_ORIGINS=https://agentbets.gg,https://www.agentbets.gg

# Require transaction signature for all bets (recommended for production)
REQUIRE_TX_SIGNATURE=true

# ===========================================
# x402 PAYMENT SETTINGS
# ===========================================

# Verify x402 payments on-chain (enabled in production by default)
# X402_VERIFY_ONCHAIN=true

# ===========================================
# BOT WEBHOOK
# ===========================================

# URL to notify bot when resolutions are confirmed
# BOT_WEBHOOK_URL=https://your-bot.railway.app

# ===========================================
# EXTERNAL API KEYS
# ===========================================

# CoinGecko API key for token price data (Demo/Free tier)
COINGECKO_API_KEY=your-coingecko-api-key

# ===========================================
# GASLESS RELAY (Octane-Style USDC Fee Payer)
# ===========================================

# Enable/disable gasless relay (default: true)
# When enabled, agents only need USDC — no SOL required for gas
GASLESS_ENABLED=true

# Fee in USDC charged per transaction to cover SOL gas costs
# Default: 0.001 USDC (fraction of a cent)
GASLESS_FEE_USDC=0.001

# Rate limit: max gasless transactions per wallet per minute (default: 30)
# GASLESS_RATE_LIMIT=30

# ===========================================
# MOLTBOOK INTEGRATION
# ===========================================

# Moltbook developer app key for verifying agent identity tokens
# Apply at https://moltbook.com/developers/apply
# MOLTBOOK_APP_KEY=moltdev_your-app-key

# Moltbook bot API key (for AgentBetsBot to post/comment on Moltbook)
# Register bot at POST https://www.moltbook.com/api/v1/agents/register
# MOLTBOOK_BOT_API_KEY=moltbook_your-bot-key
