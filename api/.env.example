# AgentBets API Server Configuration
# Copy this to .env and fill in the values

# ===========================================
# REQUIRED - Solana Configuration
# ===========================================

# Bot keypair for creating/resolving markets on Poll.fun
# Generate with: solana-keygen new --outfile keypair.json
# Then convert to base58: node -e "console.log(require('bs58').encode(require('./keypair.json')))"
SOLANA_PRIVATE_KEY=

# Escrow wallet for receiving bets (default provided, but use your own in production)
ESCROW_WALLET=48sWTmPygvc4w2RqKMao6zXWPGzpnnD1uecXJbCkRnQM

# Solana RPC endpoint (devnet for testing)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Network selection: devnet or mainnet
SOLANA_NETWORK=devnet

# ===========================================
# OPTIONAL - Platform Configuration
# ===========================================

# API server port (default: 3002)
PORT=3002

# Public URL for Blink icon and links
AGENTBETS_URL=https://agentbets.gg

# Admin wallet for market resolution confirmation
# ADMIN_WALLET=ESutJq7VqRER499A78W9BJCjdtZAqMJWy6hjf4HCjtsG

# SOL price in USD for USDC conversion (default: 150)
# SOL_PRICE_USD=150

# ===========================================
# x402 PAYMENT SETTINGS
# ===========================================

# Skip on-chain verification in development (NOT for production!)
# SKIP_X402_VERIFICATION=true

# ===========================================
# BOT WEBHOOK
# ===========================================

# URL to notify bot when resolutions are confirmed
# BOT_WEBHOOK_URL=https://your-bot.railway.app

# ===========================================
# EXTERNAL API KEYS
# ===========================================

# CoinGecko API key for token price data (Demo/Free tier)
COINGECKO_API_KEY=your-coingecko-api-key
