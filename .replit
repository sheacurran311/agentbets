run = "npm run start"
entrypoint = "api/src/index.js"
modules = ["nodejs-20", "web", "nix"]

hidden = [".config", "package-lock.json"]

[nix]
channel = "stable-25_05"

[deployment]
build = ["sh", "-c", "cd frontend && npm install && npm run build"]
run = ["sh", "-c", "cd api && node src/index.js"]
deploymentTarget = "cloudrun"
ignorePorts = false

[[ports]]
localPort = 3002
externalPort = 3002

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"
port = 5000

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && npx concurrently --kill-others --kill-signal SIGTERM \"cd api && node src/index.js\" \"cd frontend && npm run dev\""
waitForPort = 5000
